# Global default: enforce LF line endings on check-in and checkout
* text=auto eol=lf

# Explicitly ensure text files use LF
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.arb text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.env text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Binary file handling
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.jar binary
*.keystore binary
*.jks binary
